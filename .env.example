# PostgreSQL
POSTGRES_USER=kindred
POSTGRES_PASSWORD=kindred
POSTGRES_DB=genealogy

# Branding (provisional working title — change both to rebrand the app)
APP_NAME=Progenies
VITE_APP_NAME=Progenies

# Backend
DATABASE_URL=postgresql://kindred:kindred@db:5432/genealogy
SECRET_KEY=change-me-in-production
# When set, creating the FIRST user account requires this token. Leave empty for
# local dev; set it on any internet-facing deploy (openssl rand -hex 16) so a
# stranger can't register before you do and become the instance's first user.
BOOTSTRAP_TOKEN=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173
# Extra allowed-origin regex (on top of CORS_ORIGINS). Secure default: empty; dev
# compose opts into a localhost/private-LAN regex for phone/iPad testing.
CORS_ORIGIN_REGEX=
# Refresh-cookie Secure flag. Secure default: true (cookie sent over HTTPS only);
# dev compose opts out because dev runs on plain http.
COOKIE_SECURE=true
# Interactive API docs (/docs, /redoc, /openapi.json). Secure default: false so
# prod doesn't expose its schema; dev compose opts in.
DOCS_ENABLED=false
# Sources the backend trusts for X-Forwarded-For / X-Forwarded-Proto (uvicorn's
# proxy-headers list; IPs or CIDRs, comma-separated). Production only — the
# default covers the Docker private ranges, i.e. the nginx container in front.
FORWARDED_ALLOW_IPS=172.16.0.0/12,10.0.0.0/8

# Production stack (docker-compose.prod.yml) only
# Host interface the web port binds to. 0.0.0.0 = every interface (LAN too).
# Use 127.0.0.1 when cloudflared runs on the same host and is pointed at
# http://127.0.0.1:<HTTP_PORT>, so the LAN can't bypass Cloudflare.
HTTP_BIND=0.0.0.0
# ABSOLUTE host path for the database files and backups. Inside a Portainer
# stack the default ./data lands in Portainer's own volume — set this to a real
# (ideally encrypted) shared folder on the NAS.
#DATA_PATH=/volume1/docker/progenies

# Frontend
# Leave blank to auto-detect the API from the page's host (works at localhost,
# 127.0.0.1, and the machine's LAN IP). Set only if the API lives on a different
# host/domain, e.g. behind the Cloudflare Tunnel in production.
VITE_API_BASE_URL=
