# Top-level runtime dependencies. requirements.txt is GENERATED from this file
# with per-file hashes (the image installs with --require-hashes) — edit the
# pins here, then regenerate:
#
#   pip install pip-tools
#   pip-compile --generate-hashes --allow-unsafe --strip-extras \
#       -o requirements.txt requirements.in
#
# Compile with the same Python the image uses (3.11) so the resolved set
# matches production: docker run --rm -v "$PWD:/w" -w /w python:3.11-slim ...
fastapi==0.162.0
# Pinned explicitly: fastapi only declares `starlette>=0.46`, and the ASGI
# layer the app runs on should not move without showing up in a diff.
